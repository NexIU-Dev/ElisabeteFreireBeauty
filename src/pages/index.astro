---
import '@fontsource/allura/400.css';
import '@fontsource/fraunces/400.css';
import '@fontsource/fraunces/400-italic.css';
import '@fontsource/fraunces/500.css';
import '@fontsource/figtree/400.css';
import '@fontsource/figtree/500.css';
import '@fontsource/figtree/600.css';
import '../styles/global.css';
import { business, mapHref, services, whatsappHref } from '../data/site';

const base = import.meta.env.BASE_URL;
const asset = (path: string) => `${base}${path.replace(/^\//, '')}`;
const mainWhatsApp = whatsappHref();
const title = 'Elisabete Freire Beauty | Cílios, maquiagem e sobrancelhas em São José dos Campos';
const description = 'Cílios, maquiagem e sobrancelhas com atendimento personalizado no Parque Industrial, em São José dos Campos. Agende pelo WhatsApp.';
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BeautySalon',
  name: `${business.name} - ${business.descriptor}`,
  description,
  telephone: `+${business.phoneE164}`,
  sameAs: [business.instagram],
  address: { '@type': 'PostalAddress', streetAddress: 'R. Pimenteiras, 848', addressLocality: 'São José dos Campos', addressRegion: 'SP', postalCode: '12235-750', addressCountry: 'BR' },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '08:00', closes: '18:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '08:00', closes: '14:00' },
  ],
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f9f3ed" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href={asset('/favicon.svg')} />
    <link rel="preload" as="image" href={asset('/images/olhar-brow-lamination.jpg')} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <header class="site-header" id="inicio">
      <div class="header-inner page-shell">
        <a class="brand" href="#inicio" aria-label="Elisabete Freire Beauty, voltar ao início">
          <span class="brand-script">Elisabete</span>
          <span class="brand-detail">Freire Beauty</span>
        </a>
        <nav class="desktop-nav" aria-label="Navegação principal">
          <a href="#servicos">Serviços</a>
          <a href="#sobre">Elisabete</a>
          <a href="#visite">Onde estamos</a>
        </nav>
        <a class="header-booking" href={mainWhatsApp} target="_blank" rel="noopener noreferrer">Agendar horário</a>
      </div>
    </header>

    <main id="conteudo">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-inner page-shell">
          <div class="hero-copy">
            <h1 id="hero-title"><span class="hero-signature">Elisabete</span><span class="hero-surname">Freire<span class="hero-period">.</span></span></h1>
            <p class="hero-offer">Cílios, maquiagem e sobrancelhas em São José dos Campos.</p>
            <p class="hero-context">Atendimento com Elisabete no Parque Industrial.</p>
            <div class="hero-actions">
              <a class="booking-button" href={mainWhatsApp} target="_blank" rel="noopener noreferrer">
                <span>Agendar pelo WhatsApp</span>
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20.2 11.6a8.2 8.2 0 0 1-12 7.3L4 20l1.1-4a8.2 8.2 0 1 1 15.1-4.4Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M9 8.5c.3-.4.6-.4.9-.3l1.1 1.6c.1.2.1.5-.1.7l-.5.6c.7 1.3 1.6 2.2 2.9 2.8l.6-.6c.2-.2.5-.2.7-.1l1.6 1.1c.3.2.3.6.1.9-.5.7-1.2 1-2 1-2.5-.1-6.4-4-6.4-6.5 0-.5.3-1 .8-1.2Z" fill="currentColor"/></svg>
              </a>
              <a class="hero-services-link" href="#servicos">Ver serviços</a>
            </div>
          </div>
          <div class="hero-art">
            <div class="hero-photo">
              <img src={asset('/images/olhar-brow-lamination.jpg')} width="1440" height="1920" alt="Cílios e sobrancelha em trabalho realizado pelo studio Elisabete Freire Beauty" fetchpriority="high" decoding="async" />
            </div>
            <svg class="hero-stroke" viewBox="0 0 510 195" preserveAspectRatio="none" fill="none" aria-hidden="true"><path d="M8 156C85 99 184 67 279 71c87 4 158 42 222 113" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            <div class="hero-small-photo"><img src={asset('/images/maquiagem-formatura.jpg')} width="361" height="640" alt="Maquiagem social realizada pelo studio" loading="eager" decoding="async" /></div>
          </div>
        </div>
      </section>

      <section class="services-section" id="servicos" aria-labelledby="services-title">
        <div class="services-inner page-shell">
          <div class="services-copy">
            <h2 id="services-title">O que você <em>procura?</em></h2>
            <div class="service-list" data-service-list>
              {services.map((service, index) => (
                <article class="service-row" data-service-row data-index={index}>
                  <div class="service-row-text">
                    <h3>{service.name}</h3>
                    <p>{service.description}</p>
                    <a href={whatsappHref(service.slug)} target="_blank" rel="noopener noreferrer">Agendar {service.name.toLowerCase()}</a>
                  </div>
                  <img class="service-mobile-photo" src={asset(service.image)} width={service.width} height={service.height} alt={service.alt} loading="lazy" decoding="async" />
                </article>
              ))}
            </div>
          </div>
          <div class="service-preview" aria-hidden="true">
            <div class="preview-paper">
              {services.map((service, index) => (
                <img class:list={['preview-image', { 'is-active': index === 0 }]} src={asset(service.image)} width={service.width} height={service.height} alt="" loading="lazy" decoding="async" data-preview-image />
              ))}
            </div>
          </div>
        </div>
      </section>

      <section class="about-section" id="sobre" aria-labelledby="about-title">
        <div class="about-inner page-shell">
          <div class="about-portrait">
            <img src={asset('/images/elisabete-retrato.jpg')} width="150" height="150" alt="Retrato de Elisabete Freire" loading="lazy" decoding="async" />
            <span>Elisabete</span>
          </div>
          <div class="about-copy">
            <h2 id="about-title">Elisabete Freire.</h2>
            <p>É com ela o atendimento no studio do Parque Industrial. Elisabete trabalha com extensão de cílios, maquiagem e design de sobrancelhas, ouvindo o que cada cliente deseja antes de começar.</p>
            <p class="about-rating">Avaliação <strong>{business.rating} / 5</strong></p>
            <a href={mainWhatsApp} target="_blank" rel="noopener noreferrer">Falar com Elisabete</a>
          </div>
        </div>
      </section>

      <section class="visit-section page-shell" id="visite" aria-labelledby="visit-title">
        <div class="visit-heading">
          <h2 id="visit-title">Venha ao studio.</h2>
          <p>R. Pimenteiras, 848<br />Parque Industrial<br />São José dos Campos - SP, 12235-750</p>
          <a href={mapHref} target="_blank" rel="noopener noreferrer">Ver caminho no mapa</a>
        </div>
        <div class="visit-hours">
          <h3>Horários</h3>
          <dl><div><dt>Terça a sexta</dt><dd>08h às 18h</dd></div><div><dt>Sábado</dt><dd>08h às 14h</dd></div><div><dt>Domingo e segunda</dt><dd>Fechado</dd></div></dl>
          <a href={`tel:+${business.phoneE164}`}>{business.phoneDisplay}</a>
        </div>
      </section>

      <section class="last-call" aria-labelledby="last-call-title">
        <div class="last-call-inner page-shell">
          <h2 id="last-call-title">Agende com Elisabete.</h2>
          <a class="booking-button booking-button-light" href={mainWhatsApp} target="_blank" rel="noopener noreferrer">Falar com Elisabete</a>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-inner page-shell">
        <a class="footer-brand" href="#inicio"><span>Elisabete</span><small>Freire Beauty</small></a>
        <div class="footer-links"><a href={business.instagram} target="_blank" rel="noopener noreferrer">Instagram</a><a href={`tel:+${business.phoneE164}`}>{business.phoneDisplay}</a><a href="#inicio">Voltar ao início</a></div>
        <small>© {new Date().getFullYear()} Elisabete Freire Beauty</small>
      </div>
    </footer>
    <script>
      const rows = document.querySelectorAll<HTMLElement>('[data-service-row]');
      const images = document.querySelectorAll<HTMLElement>('[data-preview-image]');
      function showService(index: number) {
        rows.forEach((row, i) => row.classList.toggle('is-active', i === index));
        images.forEach((image, i) => image.classList.toggle('is-active', i === index));
      }
      rows.forEach((row, index) => {
        row.addEventListener('mouseenter', () => showService(index));
        row.addEventListener('focusin', () => showService(index));
      });
      showService(0);
    </script>
  </body>
</html>
